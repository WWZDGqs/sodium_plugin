{
	"schemaVersion": 1,
	"id": "sodium_plugin",
	"version": "${version}",
	"name": "Sodium View Shake Control",
	"description": "视角抖动强度、受击/疾跑抖动、粒子、FOV、伽马、玩家高亮、伤害飘字、击杀回放等战斗 HUD 增强；设置界面由 Mod Menu 提供。",
	"authors": [
		"WWZDGqs"
	],
	"contact": {
		"homepage": "https://github.com/WWZDGqs/WWZDGqs",
		"sources": "https://github.com/WWZDGqs/WWZDGqs",
		"issues": "https://github.com/WWZDGqs/WWZDGqs/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/sodium_plugin/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"value": "ws.sodiunplugin.Ws_sodium_plugin",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "ws.sodiunplugin.Ws_sodium_pluginClient",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			"ws.sodiunplugin.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"sodium_plugin.mixins.json",
		{
			"config": "sodium_plugin.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"modmenu": ">=11.0.0"
	},
	"recommends": {
		"sodium": ">=0.5.0"
	},
	"suggests": {
		"another-mod": "*"
	}
}
